DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product_verifier

# Local Redis: redis://localhost:6379/0
# AWS ElastiCache: rediss://:<auth-token>@<endpoint>:6379/0
REDIS_URL=redis://localhost:6379/0

# Set a strong secret in deployment; do not use the development fallback.
AUTH_SECRET_KEY=replace-with-a-long-random-secret